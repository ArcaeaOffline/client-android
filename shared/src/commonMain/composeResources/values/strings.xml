    <string name="play_result_validator_score_is_zero_title">Score is zero</string>
    <string name="play_result_validator_score_is_zero_message">Score is zero.</string>
    <string name="play_result_validator_clear_type_missing_title">Clear type missing</string>
    <string name="play_result_validator_clear_type_missing_message">The B50 rules count a play without a clear type as TRACK LOST, so it earns no clear bonus.</string>

    <string name="play_result_validator_score_out_of_range_title">Score out of range</string>
    <string name="play_result_validator_score_out_of_range_message">The score calculation based on the pure/far value does not match the given score.</string>

    <string name="play_result_validator_score_impossible_title">Impossible score</string>
    <string name="play_result_validator_score_impossible_message">The score is below zero or above Max PURE MEMORY.</string>

    <string name="play_result_validator_pm_score_too_low_title">PURE MEMORY score too low</string>
    <string name="play_result_validator_pm_score_too_low_message">A PURE MEMORY play result scores at least 10000000.</string>

    <string name="play_result_validator_pfl_overflow_title">Notes overflow</string>
    <string name="play_result_validator_pfl_overflow_message">The sum of pure, far and lost is greater than the total notes of the chart.</string>

    <string name="play_result_validator_max_recall_overflow_title">MAX RECALL overflow</string>
    <string name="play_result_validator_max_recall_overflow_message">The max recall is greater than the number of judgments that are not LOST.</string>

    <string name="play_result_validator_negative_count_title">Negative counts</string>
    <string name="play_result_validator_negative_count_message">pure, far, lost and max recall cannot be negative.</string>

    <string name="play_result_validator_fr_pm_max_recall_mismatch_title">FR/PM MAX RECALL mismatch</string>
    <string name="play_result_validator_fr_pm_max_recall_mismatch_message">The max recall of a FULL RECALL / PURE MEMORY play result should be equal to the total notes of the chart.</string>

    <string name="play_result_validator_clear_pfl_mismatch_title">Notes mismatch</string>
    <string name="play_result_validator_clear_pfl_mismatch_message">The sum of pure, far, lost of a non HARD LOST play result should be equal to the total notes of the chart.</string>

    <string name="play_result_validator_full_recall_lost_not_zero_title">FULL RECALL?</string>
    <string name="play_result_validator_full_recall_lost_not_zero_message">The lost of a FULL RECALL play result should be zero.</string>

    <string name="play_result_validator_plain_clear_without_lost_title">Clear type &amp; lost mismatch</string>
    <string name="play_result_validator_plain_clear_without_lost_message">A Normal/Easy/Hard Clear play result should have at least one lost.</string>

    <string name="play_result_validator_pure_memory_far_lost_not_zero_title">PURE MEMORY?</string>
    <string name="play_result_validator_pure_memory_far_lost_not_zero_message">The far and lost of a PURE MEMORY play result should be zero.</string>

    <string name="play_result_validator_all_pure_not_pm_title">Should be PURE MEMORY</string>
    <string name="play_result_validator_all_pure_not_pm_message">A play result with 0 far and 0 lost should be a PURE MEMORY.</string>

    <string name="play_result_validator_modifier_clear_type_mismatch_title">Modifier &amp; Clear Type mismatch</string>
    <string name="play_result_validator_modifier_clear_type_mismatch_message">A HARD CLEAR clear type should have the HARD modifier, and the same for EASY and NORMAL CLEAR.</string>
</resources>
